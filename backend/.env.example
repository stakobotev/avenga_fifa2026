# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prode
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Azure AD
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here

# Spring Profile (dev = H2, prod = PostgreSQL + Azure AD)
SPRING_PROFILES_ACTIVE=prod

# Football-Data.org API (for automatic match result updates)
FOOTBALL_DATA_API_KEY=your-api-key-here
FOOTBALL_DATA_ENABLED=true
FOOTBALL_DATA_COMPETITION_ID=2000
FOOTBALL_DATA_SYNC_INTERVAL=300000
